{
  "version": 2,
  "builds": [
    {
      "src": "api/login.php",
      "use": "@vercel/php@1.0.0"
    }
    // 如果有更多 PHP（如 dashboard.php），加一行：{ "src": "api/dashboard.php", "use": "@vercel/php@1.0.0" }
  ],
  "routes": [
    {
      "src": "/admin/login",
      "dest": "/api/login.php"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/$1.php"  // 支持子路由，如 /admin/dashboard → api/dashboard.php
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"  // 静态页面 fallback
    }
  ],
  "functions": {
    "api/**/*.php": {
      "runtime": "@vercel/php@1.0.0",
      "maxDuration": 10  // 免费版 10s 超时
    }
  }
}
