{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php"
    },
    {
      "src": ".*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|json|xml|txt|woff|woff2|ttf|eot)",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    // 1. 直接访问 PHP 文件（如 login.php、minesweeper.php、tetris.php 等）
    {
      "src": "/(.*\\.php)$",
      "dest": "/$1"
    },

    // 2. 让 Vercel 正确处理根路径（index.php 是你的主入口）
    {
      "src": "/",
      "dest": "/index.php"
    },

    // 3. 其它所有静态资源正常访问
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],

  // 可选：如果你确实有 /api 目录下的 PHP 接口，也可以保留
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  }
}
