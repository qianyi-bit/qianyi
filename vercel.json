{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 2048,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*)",              "dest": "/api/index.php" }
  ],
  "rewrites": [
    { "source": "/(.*)",           "destination": "/api/index.php" }
  ]
}
