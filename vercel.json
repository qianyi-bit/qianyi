{
  "functions": {
    "api/**/*.php": {  // **/ 支持子目录，如 api/admin/*.php
      "runtime": "@vercel/php@1.0.0"
    }
  },
  "routes": [
    {
      "src": "/admin/(.*)",     // 捕获 /admin/xxx
      "dest": "/api/$1"         // 动态路由到 api/xxx
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
